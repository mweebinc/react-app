## Domain-Specific Templates

### For LLM Agents
```markdown
## LLM Integration Pattern

### Message Loop
```javascript
async function runAgent(prompt) {
    const messages = [{ role: "system", content: SYSTEM_PROMPT }];
    messages.push({ role: "user", content: prompt });
    
    while (true) {
        const response = await openai.chat.completions.create({
            model: "gpt-4",
            messages,
            tools: TOOL_DEFINITIONS
        });
        
        if (response.choices[0].finish_reason === "tool_calls") {
            const toolResult = await executeTool(response.choices[0].message.tool_calls[0]);
            messages.push({ role: "tool", content: toolResult });
        } else {
            return response.choices[0].message.content;
        }
    }
}
```

### Tool Definition
```javascript
const TOOL_DEFINITIONS = [{
    type: "function",
    function: {
        name: "execute_code",
        description: "Execute Python code",
        parameters: {
            type: "object",
            properties: {
                code: { type: "string" }
            }
        }
    }
}];
```
```

### For Real-time Systems (WebSocket/WebRTC)
```markdown
## Real-time Communication Pattern

### Server Setup
```javascript
const io = require('socket.io')(server);
const rooms = new Map();

io.on('connection', (socket) => {
    socket.on('join', (roomId) => {
        socket.join(roomId);
        if (!rooms.has(roomId)) {
            rooms.set(roomId, new RoomState());
        }
    });
    
    socket.on('update', (data) => {
        const room = rooms.get(data.roomId);
        room.applyUpdate(data);
        socket.to(data.roomId).emit('state', room.getState());
    });
});
```
```

